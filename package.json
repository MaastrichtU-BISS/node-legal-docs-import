{
  "name": "node-legal-docs-import",
  "version": "1.0.4",
  "description": "Turns uploaded files into documents worth annotating. Text, HTML, Word and PDF, parsed server-side so that character offsets are the same everywhere.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/node-legal-docs-import.git"
  },
  "homepage": "https://github.com/MaastrichtU-BISS/node-legal-docs-import#readme",
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/node-legal-docs-import/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "legal",
    "pdf",
    "docx",
    "text-extraction",
    "annotation",
    "server"
  ],
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2",
    "htmlparser2": "^12.0.0",
    "pdfjs-dist": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
